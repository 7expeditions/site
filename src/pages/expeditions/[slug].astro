---
// Лендинги: /expeditions/<адрес>/ из src/content/landings/<адрес>.yaml
import { getCollection } from 'astro:content';
import LandingPage from '../../components/landing/LandingPage.astro';
import { enforce } from '../../lib/rules';

export async function getStaticPaths() {
  const pages = await getCollection('landings');
  for (const p of pages) enforce('лендинг ', p.id, p.data);
  return pages.map(p => ({ params: { slug: p.id }, props: { page: p.data, slug: p.id } }));
}
const { page, slug } = Astro.props;
---
<LandingPage page={page} slug={slug} />
