---
// Страница лендинга: шапка из полей, блоки по порядку, контакт и подвал.
import Base from '../../layouts/Base.astro';
import '../../styles/tokens.css';
import '../../styles/grain.css';
import '../../styles/landing.css';
import Head from './Head.astro';
import Cover from './Cover.astro';
import Lead from './Lead.astro';
import Diptych from './Diptych.astro';
import MapSec from './MapSec.astro';
import Day from './Day.astro';
import Photo from './Photo.astro';
import Trio from './Trio.astro';
import Notes from './Notes.astro';
import Why from './Why.astro';
import Summary from './Summary.astro';
import Heading from './Heading.astro';
import Placeholder from './Placeholder.astro';
import Contact from './Contact.astro';
import { LEGACY } from '../../lib/rules';
const { page, slug } = Astro.props;
// Имя компании и контакты поверх обложки, имя компании во вкладке и превью: у всех лендингов, кроме прежних (LEGACY).
const brand = !LEGACY.includes(slug);
const C: Record<string, any> = { cover: Cover, lead: Lead, diptych: Diptych, map: MapSec, day: Day, photo: Photo,
  trio: Trio, notes: Notes, why: Why, summary: Summary, heading: Heading, placeholder: Placeholder };
---
<Base icon={page.favicon ? 'seven' : 'off'}>
  <Head slot="head" page={page} brand={brand} />
  {page.blocks.map((b: any) => { const X = C[b.type]; return <X b={b} brand={brand && b.type === 'cover'} />; })}
  <Contact />
</Base>
