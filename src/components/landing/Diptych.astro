---
import Pic from '../Pic.astro';
import { ratio } from '../../lib/media';
const { b } = Astro.props;
// панель: обрезка по высоте экрана (78vh на телефоне, весь экран от 900px); full — фото целиком
const sz = (url: string, m?: string) => {
  if (b.full) return { sizes: '(min-width:900px) 50vw, 100vw', msizes: '100vw' };
  const r = ratio(url), rm = m ? ratio(m) : r;
  return {
    sizes: `(min-width:900px) max(50vw, ${Math.ceil(r * 100)}vh), max(100vw, ${Math.ceil(r * 78)}vh)`,
    msizes: `max(100vw, ${Math.ceil(rm * 78)}vh)`,
  };
};
---
<section class:list={['diptych', { full: b.full }]}>
  {b.panels.map((p: any) => (
    <div class:list={['panel', { nophoto: !p.pic }]}>
      {p.pic && <Pic pic={p.pic} {...sz(p.pic.src, p.pic.m)} />}
      <div class="shade"></div>
      <div class="over">
        <span class="num" set:html={p.num} />
        <h2 class="hero" set:html={p.hero} />
        <p class="acc" set:html={p.acc} />
      </div>
    </div>
  ))}
</section>
