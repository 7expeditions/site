---
// <picture>: webp-варианты разной ширины, отдельный кадр для вертикального экрана (pic.m),
// в <img> — оригинал по прежнему адресу (запасной вариант без webp).
import { media, isRaster, srcset, WIDTHS } from '../lib/media';
interface Props {
  pic: { src: string; m?: string; alt?: string; pos?: string; mpos?: string };
  sizes?: string;       // для основного кадра
  msizes?: string;      // для кадра телефона
  cls?: string;
  eager?: boolean;
}
const { pic, sizes = '100vw', msizes = '100vw', cls, eager = false } = Astro.props;
const raster = isRaster(pic.src);
const meta = raster ? media(pic.src) : null;
const mMeta = pic.m && isRaster(pic.m) ? media(pic.m) : null;
const mSet = mMeta ? await srcset(pic.m!, WIDTHS.tall) : null;
const dSet = raster ? await srcset(pic.src, WIDTHS.wide) : null;
const style = [pic.pos && `object-position:${pic.pos}`, pic.mpos && `--mpos:${pic.mpos}`].filter(Boolean).join(';') || undefined;
const classes = [cls, pic.mpos && 'mp'].filter(Boolean).join(' ') || undefined;
---
<picture>
  {pic.m && (mSet
    ? <source media="(orientation: portrait)" type="image/webp" srcset={mSet} sizes={msizes} width={mMeta!.width} height={mMeta!.height}>
    : <source media="(orientation: portrait)" srcset={pic.m}>)}
  {dSet && <source type="image/webp" srcset={dSet} sizes={sizes}>}
  <img src={pic.src} alt={pic.alt ?? ''} class={classes} style={style}
    width={meta?.width} height={meta?.height}
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async">
</picture>
